# Solana/SVM profiles. The public x402 facilitator supports Solana devnet exact payments.
X402_SVM_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
X402_SVM_SERVER_ADDRESS=replace-with-solana-receiving-address
SVM_PRIVATE_KEY=replace-with-base58-encoded-64-byte-solana-keypair
